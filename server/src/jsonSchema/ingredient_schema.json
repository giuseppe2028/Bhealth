{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "calories": {
      "type": "number"
    },
    "nutrients": {
      "type": "object",
      "properties": {
        "fat": {
          "type": "number"
        },
        "carb": {
          "type": "number"
        },
        "protein": {
          "type": "number"
        }
      }
    }
  },
  "additionalProperties": false
}
